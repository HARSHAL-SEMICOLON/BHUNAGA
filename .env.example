# Copy this file to .env and fill in your own keys. .env is gitignored.

# ---------------------------------------------------------------- required
# Groq API key (free) — https://console.groq.com/keys
# Used for the answers, the council and the voice transcription.
GROQ_API_KEY=

# ---------------------------------------------------------------- optional
# Qdrant Cloud cluster. If you leave these blank or the cluster is switched
# off, the app falls back to a local index on this computer and still works.
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Where the vectors live:
#   auto   — try Qdrant, fall back to the local store   (default, recommended)
#   local  — always local, never touch the network
#   qdrant — Qdrant only, fail loudly if it is down
VECTOR_BACKEND=auto

# The council of experts: three specialists plus a chairman instead of one
# model answering alone. Set to 0 for plain single-model answers, which is
# also how you produce the baseline in evaluate.py.
COUNCIL_ENABLED=1

# The chairman can run on a different model from the experts. Defaults to the
# same one. A smaller model here is cheaper and usually good enough for merging.
CHAIRMAN_MODEL=

# How to answer Marathi: "native" or "translate_after"
MARATHI_STRATEGY=native

# Embedding model. The default is BGE-M3 (1024 dims). Only change both together.
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DIM=1024

# Mandi prices. A demo key is built in but is heavily rate limited — get your
# own free key at https://data.gov.in/help/how-use-datasets-apis
DATA_GOV_API_KEY=
